# Vandad Agent — initial provider scope: GPT for scenarios, KIE for video.
# Copy to .env. Never commit real credentials.

# Application
APP_NAME="Vandad Agent"
ENVIRONMENT=local
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console
READINESS_TIMEOUT_SECONDS=3

# PostgreSQL
POSTGRES_USER=vandad
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vandad_agent
POSTGRES_PORT=15432
DATABASE_URL=postgresql+asyncpg://vandad:change-me-strong-password@localhost:15432/vandad_agent
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:change-me-redis-password@localhost:6379/0
REDIS_SOCKET_TIMEOUT=5
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_MAX_CONNECTIONS=10

# API and Web
API_PORT=8000
WEB_PORT=3000
NEXT_PUBLIC_COMPANY_ID=
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXY_NETWORK=trusted-proxy

# Docker build mirrors (optional)
PIP_INDEX_URL=https://pypi.org/simple
APT_MIRROR=deb.debian.org

# Credential encryption (AES-256-GCM). scripts/setup.ps1 generates a unique key.
CREDENTIAL_MASTER_KEYS={}
CREDENTIAL_ACTIVE_KEY_VERSION=1

# Authorization
PLATFORM_BOOTSTRAP_COMPANY_IDS=*
AUTH_PROXY_SHARED_SECRET=
AUTH_PROXY_USER_HEADER=X-Auth-Request-User
AUTH_PROXY_COMPANY_IDS_HEADER=X-Auth-Request-Company-IDs
AUTH_PROXY_ROLES_HEADER=X-Auth-Request-Roles

# Artifact storage and workers
ARTIFACT_STORAGE_ROOT=/app/data/artifacts
ARTIFACT_MAX_SIZE_BYTES=2147483648
WORKER_CONCURRENCY=4
WORKER_SCHEDULER_INTERVAL=5
AGENT_WORKER_CONCURRENCY=3
AGENT_WORKER_POLL_INTERVAL=1
AGENT_WORKER_LEASE_SECONDS=120

# GPT scenario generation
# Configure an llm_openai connection from Settings in the UI.
# The API key is encrypted in the tenant credential vault; do not put it here.
# Use the official OpenAI endpoint and a GPT model in that connection.

# KIE video generation — the only active video provider in this phase.
SCENE_VIDEO_PROVIDER=kie
SCENE_VIDEO_KIE_API_KEY=
SCENE_VIDEO_KIE_BASE_URL=https://api.kie.ai
SCENE_VIDEO_KIE_MODEL=grok-imagine/image-to-video
SCENE_VIDEO_KIE_RESOLUTION=480p
SCENE_VIDEO_KIE_ASPECT_RATIO=9:16
SCENE_VIDEO_KIE_MODE=normal
SCENE_VIDEO_KIE_TIMEOUT_SECONDS=60
SCENE_VIDEO_KIE_PRICE_PER_CREDIT_USD=0.005
SCENE_VIDEO_KIE_DOWNLOAD_ALLOWED_HOSTS=
SCENE_VIDEO_KIE_UPLOAD_BASE_URL=
SCENE_VIDEO_KIE_UPLOAD_PATH=vandad/character-references
SCENE_VIDEO_GENERATION_MODE=single_shot
SCENE_VIDEO_POLL_INTERVAL_SECONDS=3
SCENE_VIDEO_MAX_POLL_ATTEMPTS=300
SCENE_VIDEO_MAX_SCENE_ATTEMPTS=3
SCENE_VIDEO_DAILY_QUOTA=

# Content assets and public-platform knowledge refresh
PLATFORM_CHARACTERS_ROOT=assets/Paltform_charactar
PLATFORM_SCREENSHOTS_ROOT=assets/platform_screenshots
PLATFORM_CLIPS_ROOT=assets/clips
END_CARD_SECONDS=3
PLATFORM_MONITOR_ENABLED=true
PLATFORM_MONITOR_INTERVAL_SECONDS=21600

# Provider execution safeguards
PROVIDER_DEFAULT_TIMEOUT_SECONDS=10
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BACKOFF_SECONDS=0.5
