# =============================================================================
# Vandad Agent - environment template
# Copy to `.env` and replace every change-me value before starting.
#   cp .env.example .env
# NEVER commit the real .env file.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Vandad Agent"
ENVIRONMENT=local              # local | development | staging | production
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console             # console (dev) | json (compose/production)

# --- PostgreSQL (used by compose; host-run API uses DATABASE_URL below) ------
# Host port 15432 avoids Windows' reserved dynamic-port ranges (5341-5440
# covers 5432 on many machines). The in-network port is always 5432.
POSTGRES_USER=vandad
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=vandad_agent
POSTGRES_PORT=15432

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=change-me-redis-password
REDIS_PORT=6379

# --- API ---------------------------------------------------------------------
API_PORT=8000
# Browser-facing API URL embedded into the web build; replace for staging.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Exact browser origins; never use * when credentials are enabled.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Existing Docker network shared with the externally managed OIDC proxy.
TRUSTED_PROXY_NETWORK=trusted-proxy

# --- n8n ---------------------------------------------------------------------
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
# Generate with: openssl rand -base64 32  (encrypts stored n8n credentials)
N8N_ENCRYPTION_KEY=change-me-openssl-rand-base64-32
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_TIMEZONE=UTC
# false because n8n is served over plain http on localhost; set true behind https
N8N_SECURE_COOKIE=false

# --- Local development (host-run API against dockerized services) -----------
DATABASE_URL=postgresql+asyncpg://vandad:change-me-strong-password@localhost:15432/vandad_agent
REDIS_URL=redis://:change-me-redis-password@localhost:6379/0

# --- Docker build ------------------------------------------------------------
# PyPI index used during `docker compose build`. Set to a mirror if pypi.org
# is not reachable from the build environment, e.g.
#   PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple/
PIP_INDEX_URL=https://pypi.org/simple

# --- n8n integration (prepared for a future phase) ---------------------------
N8N_BASE_URL=http://localhost:5678/
N8N_API_KEY=

# --- Credential encryption (AES-256-GCM) --------------------------------------
# JSON mapping key version -> base64 32-byte key. Generate: openssl rand -base64 32
CREDENTIAL_MASTER_KEYS='{"1": "generate-with-openssl-rand-base64-32"}'
CREDENTIAL_ACTIVE_KEY_VERSION=1

# --- Provider execution --------------------------------------------------------
PROVIDER_DEFAULT_TIMEOUT_SECONDS=10
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_RETRY_BACKOFF_SECONDS=0.5

# --- Authorization boundary ----------------------------------------------------
# Comma-separated company UUIDs the bootstrap principal may act for.
# "*" is local-development only; staging/production require explicit UUIDs.
PLATFORM_BOOTSTRAP_COMPANY_IDS=*

# --- Production identity proxy ------------------------------------------------
# Required in staging/production. Generate with: openssl rand -hex 32
# The reverse proxy must strip browser-supplied X-Auth-* headers and inject
# verified claims plus X-Auth-Proxy-Secret. Never expose this secret to the UI.
AUTH_PROXY_SHARED_SECRET=
AUTH_PROXY_USER_HEADER=X-Auth-Request-User
AUTH_PROXY_COMPANY_IDS_HEADER=X-Auth-Request-Company-IDs
AUTH_PROXY_ROLES_HEADER=X-Auth-Request-Roles

# --- Artifact storage ----------------------------------------------------------
# Root directory for generated workflow artifacts. In Docker this is a mounted
# named volume (see docker-compose.yml); host runs use a local path.
ARTIFACT_STORAGE_ROOT=/app/data/artifacts

# --- Content providers (Phase 4) -----------------------------------------------
# Provider credentials are NOT stored here. Create a platform connection through
# the API and store the secret via the credential service (AES-256-GCM at rest).
#   - heygen:      configuration {"url": "https://api.heygen.com"}
#   - llm_openai:  configuration {"url": "<OpenAI-compatible base>", "model": "..."}
# HeyGen photo-avatar training and video generation are paid; the pipeline sends
# stable Idempotency-Key headers so retries never double-charge.

# --- Scene-based (non-avatar) video pipeline -----------------------------------
# The scene pipeline reuses the existing llm_openai connection for scenario
# generation. Scene clips come from a provider-neutral adapter:
#   mock          local, deterministic synthetic clips; no network, no credits
#   generic_http  an authorised provider with a documented HTTP contract
#   wavespeed     WaveSpeed LTX-2.3 scene generation; optional generic_http
#                 composition/quality delegation requires both endpoints below
# No vendor is bundled and no free video API is assumed. Do not point this at a
# paid API without explicit operator approval.
SCENE_VIDEO_PROVIDER=mock
# APIMaster opt-in: set SCENE_VIDEO_PROVIDER=apimaster only after configuring
# the API key. The key is secret and must never be committed.
SCENE_VIDEO_APIMASTER_API_KEY=
SCENE_VIDEO_APIMASTER_BASE_URL=https://apimaster.ai
SCENE_VIDEO_APIMASTER_MODEL=wan3.0-video-prime
SCENE_VIDEO_APIMASTER_ROUTE=gmi
SCENE_VIDEO_APIMASTER_RESOLUTION=720P
SCENE_VIDEO_APIMASTER_TIMEOUT_SECONDS=60
# Comma-separated exact HTTPS hostnames permitted for redirected media downloads.
SCENE_VIDEO_APIMASTER_DOWNLOAD_ALLOWED_HOSTS=

# WaveSpeed LTX-2.3 opt-in. Never commit the real API key.
# This provider generates scene clips; final composition and AI quality review
# are delegated to generic_http only when both COMPOSE_PATH and QUALITY_PATH
# are configured against an explicitly authorised service.
SCENE_VIDEO_WAVESPEED_API_KEY=
SCENE_VIDEO_WAVESPEED_BASE_URL=https://api.wavespeed.ai/api/v3
SCENE_VIDEO_WAVESPEED_MODEL=wavespeed-ai/ltx-2.3/text-to-video
SCENE_VIDEO_WAVESPEED_RESOLUTION=480p
SCENE_VIDEO_WAVESPEED_ASPECT_RATIO=9:16
# Optional fixed clip duration override; leave unset to use each storyboard scene duration.
# SCENE_VIDEO_WAVESPEED_DURATION_SECONDS=5
SCENE_VIDEO_WAVESPEED_TIMEOUT_SECONDS=60
# Exact HTTPS hostnames from the actual output URL; no wildcard support.
SCENE_VIDEO_WAVESPEED_DOWNLOAD_ALLOWED_HOSTS=
# Paid smoke test refuses any request estimated above this cap (USD).
SCENE_VIDEO_WAVESPEED_MAX_COST_USD=0.10
SCENE_VIDEO_WAVESPEED_MAX_WAIT_SECONDS=900
# Optional local daily budget (scenes/day) enforced by the platform itself.
# Leave empty for no platform-side cap (the provider may still enforce its own).
# SCENE_VIDEO_DAILY_QUOTA=   # optional integer scenes/day
SCENE_VIDEO_MAX_SCENE_ATTEMPTS=3
# For WaveSpeed, set the poll interval to 2 seconds initially (increase to 5-10s for long jobs).
SCENE_VIDEO_POLL_INTERVAL_SECONDS=30
SCENE_VIDEO_MAX_POLL_ATTEMPTS=60
SCENE_VIDEO_OUTPUT_WIDTH=1080
SCENE_VIDEO_OUTPUT_HEIGHT=1920
SCENE_VIDEO_OUTPUT_FPS=30
SCENE_ASSEMBLY_TIMEOUT_SECONDS=1800

# Optional generic HTTP contract. Leave SCENE_VIDEO_HTTP_BASE_URL empty to keep
# the generic_http provider unregistered. The API key is only sent as the
# configured auth header and is never logged.
SCENE_VIDEO_HTTP_BASE_URL=
SCENE_VIDEO_HTTP_GENERATE_PATH=/v1/videos
SCENE_VIDEO_HTTP_STATUS_PATH=/v1/videos/{job_id}
SCENE_VIDEO_HTTP_RETRIEVE_PATH=
SCENE_VIDEO_HTTP_COMPOSE_PATH=
SCENE_VIDEO_HTTP_QUALITY_PATH=
SCENE_VIDEO_HTTP_HEALTH_PATH=
SCENE_VIDEO_HTTP_API_KEY=
SCENE_VIDEO_HTTP_AUTH_HEADER=Authorization
SCENE_VIDEO_HTTP_AUTH_SCHEME=Bearer
# Comma-separated exact HTTPS hostnames from the provider's official docs.
SCENE_VIDEO_HTTP_DOWNLOAD_ALLOWED_HOSTS=
SCENE_VIDEO_HTTP_SUPPORTED_MODALITIES=video
SCENE_VIDEO_HTTP_SUPPORTED_LANGUAGES=
SCENE_VIDEO_HTTP_SUPPORTED_ASPECT_RATIOS=
# Comma-separated WIDTHxHEIGHT values, e.g. 720x1280,1080x1920.
SCENE_VIDEO_HTTP_SUPPORTED_RESOLUTIONS=
# Set SCENE_VIDEO_POLL_INTERVAL_SECONDS=2 for WaveSpeed (provider minimum is 2 seconds).
# Set true only when the upstream contract explicitly accepts a seed field.
SCENE_VIDEO_HTTP_SUPPORTS_SEED=false
# SCENE_VIDEO_HTTP_MAX_PROMPT_CHARACTERS=5000  # optional positive integer
# SCENE_VIDEO_HTTP_MIN_DURATION_SECONDS=2  # optional positive float
# SCENE_VIDEO_HTTP_MAX_DURATION_SECONDS=30  # optional positive float

# --- Docker APT mirror --------------------------------------------------------
# Debian package mirror used during docker build (constrained networks).
APT_MIRROR=deb.debian.org
